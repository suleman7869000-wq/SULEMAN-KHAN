<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>My Portfolio</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #0b0f19;
    color: white;
}

/* Navigation */
nav {
    width: 100%;
    padding: 20px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: fixed;
    top: 0;
    background: rgba(11,15,25,0.9);
    backdrop-filter: blur(10px);
    z-index: 1000;
}

.logo {
    font-size: 25px;
    font-weight: bold;
}

.logo span {
    color: #00e5ff;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 25px;
    transition: 0.3s;
}

nav a:hover {
    color: #00e5ff;
}

/* Hero */
.hero {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 100px 20px 50px;
}

.hero h1 {
    font-size: 55px;
    margin-bottom: 15px;
}

.hero h1 span {
    color: #00e5ff;
}

.hero p {
    color: #b7becd;
    font-size: 20px;
    margin-bottom: 30px;
}

.btn {
    display: inline-block;
    padding: 14px 30px;
    border-radius: 30px;
    background: #00e5ff;
    color: #061018;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
}

.btn:hover {
    transform: scale(1.05);
}

/* Sections */
section {
    padding: 90px 8%;
}

.title {
    text-align: center;
    font-size: 35px;
    margin-bottom: 45px;
}

.title span {
    color: #00e5ff;
}

/* About */
.about {
    text-align: center;
    max-width: 800px;
    margin: auto;
}

.about p {
    color: #b7becd;
    line-height: 1.8;
    font-size: 18px;
}

/* Skills */
.skills {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
}

.skill {
    padding: 20px 30px;
    background: #121927;
    border: 1px solid #263247;
    border-radius: 15px;
    transition: 0.3s;
}

.skill:hover {
    transform: translateY(-8px);
    border-color: #00e5ff;
}

/* Projects */
.projects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 25px;
}

.card {
    background: #121927;
    padding: 30px;
    border-radius: 18px;
    border: 1px solid #263247;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-8px);
    border-color: #00e5ff;
}

.card h3 {
    margin-bottom: 12px;
    color: #00e5ff;
}

.card p {
    color: #b7becd;
    line-height: 1.6;
}

/* Contact */
.contact {
    text-align: center;
}

.contact p {
    color: #b7becd;
    margin-bottom: 25px;
}

/* Footer */
footer {
    text-align: center;
    padding: 25px;
    background: #070a11;
    color: #7f899b;
}

/* Mobile */
@media (max-width: 600px) {
    nav {
        padding: 18px 5%;
    }

    nav a {
        margin-left: 10px;
        font-size: 13px;
    }

    .hero h1 {
        font-size: 40px;
    }

    .hero p {
        font-size: 17px;
    }
}
</style>
</head>

<body>

<!-- Navigation -->
<nav>
    <div class="logo">My<span>Portfolio</span></div>

    <div>
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#skills">Skills</a>
        <a href="#projects">Projects</a>
    </div>
</nav>

<!-- Home -->
<section class="hero" id="home">
    <div>
        <h1>Hi, I'm <span>Salman</span></h1>
        <p>AI & Web Development Learner 🚀</p>

        <a href="#projects" class="btn">View My Projects</a>
    </div>
</section>

<!-- About -->
<section id="about">
    <h2 class="title">About <span>Me</span></h2>

    <div class="about">
        <p>
            Welcome to my personal portfolio. I am learning web development,
            artificial intelligence and modern technology. I enjoy creating
            new projects and improving my coding skills every day.
        </p>
    </div>
</section>

<!-- Skills -->
<section id="skills">
    <h2 class="title">My <span>Skills</span></h2>

    <div class="skills">
        <div class="skill">HTML</div>
        <div class="skill">CSS</div>
        <div class="skill">JavaScript</div>
        <div class="skill">AI</div>
        <div class="skill">GitHub</div>
    </div>
</section>

<!-- Projects -->
<section id="projects">
    <h2 class="title">My <span>Projects</span></h2>

    <div class="projects">

        <div class="card">
            <h3>🌐 Website</h3>
            <p>
                My first modern website created with HTML and CSS.
            </p>
        </div>

        <div class="card">
            <h3>🤖 AI Project</h3>
            <p>
                An AI-based project created while learning modern AI tools.
            </p>
        </div>

        <div class="card">
            <h3>💻 GitHub Project</h3>
            <p>
                My coding projects and experiments published on GitHub.
            </p>
        </div>

    </div>
</section>

<!-- Contact -->
<section class="contact">
    <h2 class="title">Let's <span>Connect</span></h2>

    <p>Thanks for visiting my portfolio!</p>

    <a href="https://github.com/" class="btn">
        My GitHub
    </a>
</section>

<footer>
    © 2026 Salman | Made with ❤️ and Code
</footer>

</body>
</html>